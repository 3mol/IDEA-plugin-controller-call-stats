<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>cc.miaooo.prod-call-stats</id>

    <name>Prod Call Stats</name>

    <vendor url="https://github.com/miaooo">miaooo</vendor>

    <description><![CDATA[
        Display production call statistics (today / 7-day calls, P99 latency, error rate) above
        Spring MVC Controller methods using Code Vision. Click the badge to refresh;
        configure gateway URL, token and thresholds in <b>Settings | Tools | Prod Call Stats</b>.<br>
        When no gateway URL is configured, sample data is rendered for testing.
        ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <resource-bundle>messages.ProdCallStatsBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Code Vision registration.
             The EP qualified name is `com.intellij.codeInsight.codeVisionProvider`
             (note the `.codeInsight.` segment), so the element name under the
             `com.intellij` defaultExtensionNs is `codeInsight.codeVisionProvider`. -->
        <codeInsight.codeVisionProvider
            implementation="cc.miaooo.prodcallstats.codevision.SpringControllerStatsProvider"
            order="first"/>

        <!-- Settings panel -->
        <applicationConfigurable
            id="prodcallstats.settings"
            groupId="tools"
            bundle="messages.ProdCallStatsBundle"
            key="settings.display.name"
            instance="cc.miaooo.prodcallstats.settings.StatsSettingsConfigurable"/>

        <!-- Persistent state -->
        <applicationService
            serviceImplementation="cc.miaooo.prodcallstats.settings.StatsSettingsState"/>

        <!-- Background cache service -->
        <applicationService
            serviceImplementation="cc.miaooo.prodcallstats.stats.StatsCacheService"/>

        <!-- Notification group -->
        <notificationGroup id="Prod Call Stats" displayType="STICKY_BALLOON"/>

        <!-- Logs Code Vision registration state on project open -->
        <postStartupActivity
            implementation="cc.miaooo.prodcallstats.bootstrap.ProdCallStatsStartupActivity"/>

        <!-- Bottom tool window: full per-handler stats for the active controller -->
        <toolWindow
            id="Prod Stats"
            anchor="bottom"
            factoryClass="cc.miaooo.prodcallstats.ui.ClassStatsToolWindowFactory"
            icon="AllIcons.Actions.Show"
            secondary="true"/>
    </extensions>
</idea-plugin>
